{
  "name": "opencode-argus",
  "version": "0.1.0",
  "description": "Solidity smart contract security auditing plugin for OpenCode — 4 specialized agents, 8 tools, and a curated vulnerability knowledge base",
  "keywords": ["solidity", "security", "audit", "opencode", "plugin", "smart-contract", "ethereum", "defi", "slither", "foundry"],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "argus": "./src/cli/index.ts"
  },
  "files": ["src/", "skills/", "docs/", "README.md", "AGENTS.md", "LICENSE"],
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "cli": "bun src/cli/index.ts",
    "doctor": "bun src/cli/index.ts doctor",
    "init": "bun src/cli/index.ts init"
  },
  "dependencies": {
    "@opencode-ai/plugin": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "peerDependencies": {
    "slither-analyzer": "*",
    "foundry": "*"
  },
  "peerDependenciesMeta": {
    "slither-analyzer": { "optional": true },
    "foundry": { "optional": true }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/opencode-argus"
  },
  "license": "MIT",
  "engines": { "bun": ">=1.0.0" }
}
